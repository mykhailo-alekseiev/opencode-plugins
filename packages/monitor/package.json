{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mykhailo-alekseiev/opencode-monitor",
  "version": "0.1.0",
  "description": "Background monitors that wake an OpenCode V2 session on command output",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykhailo-alekseiev/opencode-plugins.git",
    "directory": "packages/monitor"
  },
  "homepage": "https://github.com/mykhailo-alekseiev/opencode-plugins/tree/main/packages/monitor",
  "bugs": "https://github.com/mykhailo-alekseiev/opencode-plugins/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "monitor"
  ],
  "exports": {
    ".": "./src/server.ts",
